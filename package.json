    "preview:components": "turbo run storybook --filter=@common/components",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "turbo": "2.4.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.18",
      "@types/react-dom": "^18.3.5",
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  },
